<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProjectApp.ViewModels"
             xmlns:svc="clr-namespace:ProjectApp.Services"
             xmlns:models="clr-namespace:ProjectApp.Models"
             x:Class="ProjectApp.Pages.FavoritePage"
             x:DataType="vm:FavoritesViewModel"
             BackgroundColor="#0D1B2A"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0"
              BackgroundColor="#0D1B2A"
              Padding="16,52,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title row -->
            <Grid Grid.Row="0" ColumnDefinitions="44,*,44">

                <!-- Back button -->
                <Border Grid.Column="0"
                        BackgroundColor="#162A40"
                        StrokeThickness="1"
                        Stroke="#2A4D6E"
                        StrokeShape="RoundRectangle 14"
                        WidthRequest="44"
                        HeightRequest="44"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="‹"
                           FontSize="24"
                           TextColor="#4EA5D9"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="❤️ Yêu Thích"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#E8F4FF"
                           HorizontalOptions="Center"/>
                    <Label Text="{Binding SubtitleText}"
                           FontSize="12"
                           TextColor="#5A8AAA"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Refresh button -->
                <Border Grid.Column="2"
                        BackgroundColor="#162A40"
                        StrokeThickness="1"
                        Stroke="#2A4D6E"
                        StrokeShape="RoundRectangle 14"
                        WidthRequest="44"
                        HeightRequest="44"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding RefreshCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="↻"
                           FontSize="20"
                           TextColor="#4EA5D9"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
            </Grid>

            <!-- Divider -->
            <BoxView Grid.Row="1"
                     HeightRequest="1"
                     BackgroundColor="#1A3050"
                     Margin="0,14,0,0"/>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1">

            <!-- Empty state -->
            <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="20"
                                 Padding="40">
                <Label Text="🤍"
                       FontSize="72"
                       HorizontalOptions="Center"/>
                <Label Text="Chưa có quán yêu thích"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#E0E8FF"
                       HorizontalOptions="Center"/>
                <Label Text="Bấm icon ❤️ trên bản đồ hoặc trang chi tiết để thêm quán vào danh sách yêu thích của bạn."
                       FontSize="14"
                       TextColor="#4A6A85"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"/>
                <Border BackgroundColor="#1565C0"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        Padding="24,14"
                        Margin="0,8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToMapCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="🗺️  Khám phá bản đồ"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"/>
                </Border>
            </VerticalStackLayout>

            <!-- List -->
            <RefreshView IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}"
                         RefreshColor="#4EA5D9"
                         IsVisible="{Binding IsNotEmpty}">
                <CollectionView ItemsSource="{Binding Favorites}"
                                SelectionMode="None"
                                Margin="0,0,0,20">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Restaurant">
                            <Grid Padding="16,8,16,0">
                                <Border BackgroundColor="#111E2D"
                                        Stroke="#1E3A58"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 18"
                                        Padding="0">

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FavoritesViewModel}}, Path=OpenDetailCommand}"
                                            CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>

                                    <Grid RowDefinitions="160,Auto" >

                                        <!-- Image -->
                                        <Grid Grid.Row="0">
                                            <Image Source="{Binding ImageUrl}"
                                                   Aspect="AspectFill"
                                                   BackgroundColor="#0F2744"/>
                                            <!-- Gradient overlay -->
                                            <BoxView BackgroundColor="#0D1B2A"
                                                     Opacity="0.35"
                                                     VerticalOptions="End"
                                                     HeightRequest="80"/>
                                            <!-- Category badge -->
                                            <Border BackgroundColor="#1565C0"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 20"
                                                    Padding="10,4"
                                                    Margin="12,12,0,0"
                                                    HorizontalOptions="Start"
                                                    VerticalOptions="Start">
                                                <Label Text="{Binding CategoryEmoji}"
                                                       FontSize="13"
                                                       TextColor="White"/>
                                            </Border>
                                            <!-- Remove fav button -->
                                            <Border BackgroundColor="#CC1A2E"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 20"
                                                    WidthRequest="36"
                                                    HeightRequest="36"
                                                    Margin="0,10,10,0"
                                                    HorizontalOptions="End"
                                                    VerticalOptions="Start">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FavoritesViewModel}}, Path=RemoveFavoriteCommand}"
                                                        CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>
                                                <Label Text="❤️"
                                                       FontSize="15"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                            </Border>
                                        </Grid>

                                        <!-- Info -->
                                        <VerticalStackLayout Grid.Row="1"
                                                             Padding="16,12,16,16"
                                                             Spacing="6">
                                            <Label Text="{Binding DisplayName}"
                                                   FontSize="17"
                                                   FontAttributes="Bold"
                                                   TextColor="#E8F4FF"
                                                   LineBreakMode="TailTruncation"/>
                                            <Label Text="{Binding Address}"
                                                   FontSize="12"
                                                   TextColor="#5A8AAA"
                                                   LineBreakMode="TailTruncation"/>
                                            <HorizontalStackLayout Spacing="16" Margin="0,4,0,0">
                                                <Label Text="{Binding Rating, StringFormat='⭐ {0:F1}'}"
                                                       FontSize="13"
                                                       TextColor="#FFDB58"
                                                       FontAttributes="Bold"/>
                                                <Label Text="{Binding OpenHours, StringFormat='🕐 {0}'}"
                                                       FontSize="13"
                                                       TextColor="#4EC88A"
                                                       FontAttributes="Bold"/>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

        </Grid>
    </Grid>
</ContentPage>
